# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to git.

# Server
PORT=4000

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/saffron-slate
# MongoDB Atlas (free tier): get this from your Atlas cluster's "Connect" button.
MONGODB_URI=mongodb://127.0.0.1:27017/saffron-slate

# Secret used to sign JWT auth tokens. Use a long random string in production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session (JWT) stays valid.
JWT_EXPIRES_IN=7d

# The URL(s) of your frontend, used for CORS (so the browser allows requests from it).
# If you're loading the frontend from anywhere other than plain
# "http://localhost:5173" — a LAN IP, a different port, a proxied dev
# preview — add that exact address here too. Comma-separate multiple:
#   FRONTEND_URL=http://localhost:5173,http://192.168.1.12:8443
# Tip: copy the address straight from your browser's address bar
# (scheme + host + port, no trailing slash or path) to avoid typos.
FRONTEND_URL=http://localhost:5173
